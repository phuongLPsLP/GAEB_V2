     <span style="font-family:Arial;font-size:10pt;Background:rgb(255,255,255);">ä</span>
     <span style="font-family:Arial;font-size:10pt;Background:rgb(255,255,255);">tter</span>
    </p>
    <p style="font-family:Arial;font-size:10pt;Background:rgb(255,255,255);text-align:left;margin-top:0pt;margin-bottom:0pt;">
     <span style="font-family:Arial;font-size:10pt;Background:rgb(255,255,255);">- Betriebs-, Wartungs- und Reinigungsanweisungen</span>
    </p>
    <p style="font-family:Arial;font-size:10pt;Background:rgb(255,255,255);text-align:left;margin-top:0pt;margin-bottom:0pt;">
     <span style="font-family:Arial;font-size:10pt;Background:rgb(255,255,255);">- Werksbescheinigungen</span>
