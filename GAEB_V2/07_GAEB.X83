             <CompleteText>
              <DetailTxt>
               <Text>
                <p style="text-align:left;margin-top:0pt;margin-bottom:0pt;">
                 <span>Wasserfeste Dämmung für Dachventilatoren, passend zum angebotenen System</span>
                 <br/>
