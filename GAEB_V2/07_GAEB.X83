        <BoQCtgy ID="ID_141" RNoPart="8">
         <LblTx>
          <span>WA 1.1   -  (SAP 20, KG 336-2) - Absturzsicherungen Seilsicherungssystem</span>
          <br/>
          <span/>
         </LblTx>
         <BoQBody>
          <Itemlist>
           <Remark ID="ID_142">
            <Description ID="4e64d0a5-6454-4930-bd69-8c545c5ba7d2">
             <CompleteText>
              <DetailTxt>
               <Text>
                <p style="text-align:left;margin-top:0pt;margin-bottom:0pt;">
                 <span>Planverweis:</span>
                 <br/>
                 <span>NE-0747-POI1_AP_ARC_A_D_DC_527 Sekuranten + Leitersicherung Mülleinhausung</span>
                </p>
               </Text>
              </DetailTxt>
              <OutlineText>
               <OutlTxt>
                <TextOutlTxt>
                 <p style="text-align:left;margin-top:0pt;margin-bottom:0pt;">
                  <span>Absturzsicherung Mülleinhausung Haus A</span>
                 </p>
                </TextOutlTxt>
               </OutlTxt>
              </OutlineText>
             </CompleteText>
            </Description>
           </Remark>
           <Item ID="ID_143" RNoPart="1">
            <Qty>5.000</Qty>
            <QU>St</QU>
            <Description ID="053be10a-e538-4ad5-8d57-2cb6b65c5bbb">
             <CompleteText>
              <DetailTxt>
               <Text>
                <p style="text-align:left;margin-top:0pt;margin-bottom:0pt;">
                 <span>Liefern und fachgerecht montieren / versetzen von Einzelanschlagpunkt;</span>
                 <br/>
                 <span>Montage und Befestigungsmittel gemäß Systemhersteller</span>
                 <br/>
                 <span>Permanenter Edelstahl-Anschlagpunkt, geprüft nach EN 795:2012, CEN / TS 16415:2013 und in gerissenem Beton!</span>
                 <br/>
                 <span>Mit allgemeiner bauaufsichtlicher Zulassung!</span>
                 <br/>
                 <span>(Anschlagpunkt Ø = 16 mm)</span>
                 <br/>
                 <span>für max. 3 Personen</span>
                 <br/>
                 <span>Überstand = 600 mm</span>
                 <br/>
                 <span>Für einen Dachaufbau von 300 mm bis max. 600 mm.</span>
                 <br/>
                 <span>Inkl. fortlaufender Seriennummer.</span>
                 <br/>
                 <span>Inklusive geeignetem Verbundmörtel und Befestigung.</span>
                 <br/>
                 <br/>
                 <span>Einschl. Dichtmanschetten und Einbinden in die Abdichtungsbahn</span>
                 <br/>
                 <br/>
                 <span>Ausführungsort: Mülleinhausung Haus A</span>
                </p>
               </Text>
