           <Item ID="ID_27" RNoPart="3">
            <Qty>6.000</Qty>
            <QU>St</QU>
            <Description ID="d1aadae6-be45-4950-9f62-72c3a0d0b378">
             <CompleteText>
              <ComplTSB>Yes</ComplTSB>
              <DetailTxt>
               <Text>
                <p style="font-family:Arial;font-size:10pt;text-align:left;margin-top:0pt;margin-bottom:0pt;">
                 <span style="font-family:Arial;font-size:10pt;">Feuchtigkeit des Untergrundes im Beisein der Bauleitung überprüfen. Das Meßverfahren ist vorher zu definieren (CM-Gerät, Darrofen oglw.). Die Ergebnisse sind in einem Protokoll festzuhalten und der Bauleitung zu übergeben. Liegen die Werte außerhalb der vom Materialhersteller vorgegebenen Grenzwerte, sind mit der Bauleitung weitere Maßnahmen abzusprechen.</span>
                 <br/>
                 <br/>
                 <span style="font-family:Arial;font-size:10pt;">Ausführung nur auf Anordnung OÜ.</span>
                 <br/>
                 <br/>
                </p>
               </Text>
               <TextComplement MarkLbl="60" Kind="Bidder">
                <ComplCaption>
                 <span style="font-family:Arial;font-size:10pt;">Messverfahren:  </span>
                </ComplCaption>
                <ComplBody>
                 <span style="font-family:Arial;font-size:10pt;">.............................</span>
