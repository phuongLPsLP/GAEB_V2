        <BoQCtgy ID="ID_215" RNoPart="3">
         <LblTx>
          <span>WA 6.2   -   (SAP 10, KG 335-4) - Voranstrich</span>
          <br/>
          <span/>
         </LblTx>
         <BoQBody>
          <Itemlist>
           <Item ID="ID_216" RNoPart="1">
            <Qty>421.000</Qty>
            <QU>m2</QU>
            <Description ID="3f702bd3-50fc-4fd2-a4de-5646e679b78d">
             <CompleteText>
              <DetailTxt>
               <Text>
                <p style="text-align:left;margin-top:0pt;margin-bottom:0pt;">
                 <span>Einmaliger Voranstrich für bituminöse oder bitumenverträgliche Abdichtung systemverträglich</span>
                 <br/>
                 <br/>
                 <span>Untergrund: Beton</span>
                 <br/>
                 <span>Material: Bitumenlösung kalt</span>
                 <br/>
                 <span>Aufbringmenge: mind. 0,3kg/m2</span>
