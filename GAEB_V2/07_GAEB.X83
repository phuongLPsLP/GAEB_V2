    <p style="font-family:Arial;font-size:10pt;Background:rgb(255,255,255);text-align:left;margin-top:0pt;margin-bottom:0pt;">
     <span style="font-family:Arial;text-decoration:underline;font-size:10pt;Background:rgb(255,255,255);">Freigabevorgang der Ausf</span>
     <span style="font-family:Arial;text-decoration:underline;font-size:10pt;Background:rgb(255,255,255);">ü</span>
