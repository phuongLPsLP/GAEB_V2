           <Item ID="ID_162" RNoPart="9">
            <Qty>15.000</Qty>
            <QU>m</QU>
            <Description ID="980bac9f-f32e-4c25-9a76-0b95eca9c55a">
             <CompleteText>
              <DetailTxt>
               <Text>
                <p style="text-align:left;margin-top:0pt;margin-bottom:0pt;">
                 <span>Randsicherung des Plattenbelags, Steindicke 8 cm, mit Betonkeil C 20/25 aus Puzzolanzement CEM IV B (P) 32,5 N gem. EN 197-1 und Trass nach DIN 51043 und kalkfreiem Hartgesteinsplitt, Höhe / Breite ca. 10 cm.</span>
                </p>
               </Text>
              </DetailTxt>
              <OutlineText>
               <OutlTxt>
