           <Remark ID="ID_126">
            <Description ID="05ff1960-f662-43d1-82b4-9f2570daab4f">
             <CompleteText>
              <DetailTxt>
               <Text>
                <p style="text-align:left;margin-top:0pt;margin-bottom:0pt;">
                 <span>Inklusive Montagehilfsmittel und Zubehör</span>
                 <br/>
                 <br/>
                 <span>Planverweis :</span>
                 <br/>
                 <span>NE-0747-POI1_AP_ARC_A_D_DC_503 Attika Notentwässerung</span>
                </p>
               </Text>
              </DetailTxt>
