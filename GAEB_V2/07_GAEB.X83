           <Item ID="ID_232" RNoPart="5">
            <Qty>67.000</Qty>
            <QU>m2</QU>
            <Description ID="e95c6e9c-a062-4e0e-b6d0-3e95f1c9601f">
             <CompleteText>
              <DetailTxt>
               <Text>
                <p style="text-align:left;margin-top:0pt;margin-bottom:0pt;">
                 <span>Vorübergehender Schutz der Abdichtung, auf Böden, durch Abdeckung aus</span>
                 <br/>
