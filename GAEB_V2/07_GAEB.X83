           <Item ID="ID_394" RNoPart="3">
            <Qty>6.000</Qty>
            <QU>St</QU>
            <Description ID="20f71c13-42df-421e-bf4b-729ae2da9f8d">
             <CompleteText>
              <ComplTSB>Yes</ComplTSB>
              <DetailTxt>
               <Text>
                <p style="font-family:Arial;font-size:10pt;text-align:left;margin-top:0pt;margin-bottom:0pt;">
                 <span style="font-family:Arial;font-size:10pt;">Feuchtigkeit des Untergrundes im Beisein der Bauleitung überprüfen. Das Meßverfahren ist vorher zu definieren (CM-Gerät, Darrofen oglw.). Die Ergebnisse sind in einem Protokoll festzuhalten und der Bauleitung zu übergeben. Liegen die Werte außerhalb der vom Materialhersteller vorgegebenen Grenzwerte, sind mit der Bauleitung weitere Maßnahmen abzusprechen.</span>
                 <br/>
                 <br/>
                 <span style="font-family:Arial;font-size:10pt;">Ausführung nur auf Anordnung OÜ.</span>
                 <br/>
                 <br/>
                </p>
               </Text>
               <TextComplement MarkLbl="60" Kind="Bidder">
                <ComplCaption>
                 <span style="font-family:Arial;font-size:10pt;">Messverfahren:  </span>
                </ComplCaption>
                <ComplBody>
                 <span style="font-family:Arial;font-size:10pt;">.............................</span>
                </ComplBody>
                <ComplTail>
                 <span style="font-family:Arial;font-size:10pt;"> </span>
                </ComplTail>
               </TextComplement>
               <Text/>
              </DetailTxt>
              <OutlineText>
               <OutlTxt>
                <TextOutlTxt>
                 <p style="text-align:left;margin-top:0pt;margin-bottom:0pt;">
                  <span>Prüfen der Feuchtigkeit des Untergrundes</span>
                 </p>
                </TextOutlTxt>
               </OutlTxt>
              </OutlineText>
             </CompleteText>
            </Description>
           </Item>
           <Item ID="ID_395" RNoPart="4">
            <Qty>6.000</Qty>
            <QU>St</QU>
            <Description ID="cbe3882b-8ab3-439f-ab24-0150f9480dc1">
             <CompleteText>
              <DetailTxt>
               <Text>
                <p style="text-align:left;margin-top:0pt;margin-bottom:0pt;">
                 <span>Überprüfen der geforderten Haftzugfestigkeit der vorbereiteten Oberfläche im Beisein der OÜ gem. DIN EN ISO 4626. Die Ergebnisse (Prüfstelle, Werte, Trennfall) sind in einem Protokoll festzuhalten und der OÜ zu übergeben. Liegen die Werte außerhalb der vom Materialhersteller vorgegebenen Grenzwerte, sind mit der Bauleitung weitere Maßnahmen abzusprechen.</span>
                 <br/>
                 <br/>
                 <span>Ausführung nur auf Anordnung OÜ.</span>
                </p>
               </Text>
              </DetailTxt>
              <OutlineText>
               <OutlTxt>
                <TextOutlTxt>
                 <p style="text-align:left;margin-top:0pt;margin-bottom:0pt;">
                  <span>Prüfung der Haftzugfestigkeit des Untergrundes</span>
                 </p>
                </TextOutlTxt>
               </OutlTxt>
              </OutlineText>
             </CompleteText>
            </Description>
           </Item>
