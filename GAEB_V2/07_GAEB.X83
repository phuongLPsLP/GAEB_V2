                  <span>Attikablech Titanzink D 0,7 mm, Zuschnitt-B ca. 1000mm, 4 x gekantet</span>
                 </p>
                </TextOutlTxt>
               </OutlTxt>
              </OutlineText>
             </CompleteText>
            </Description>
