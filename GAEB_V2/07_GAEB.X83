           <Item ID="ID_531" RNoPart="12">
            <Qty>19.000</Qty>
            <QU>St</QU>
            <Description ID="00551e32-0382-4b2e-9409-56024aca49cf">
             <CompleteText>
              <DetailTxt>
               <Text>
                <p style="text-align:left;margin-top:0pt;margin-bottom:0pt;">
                 <span>Attikakontrollschacht als Sonderkonstruktion nach Aufmaß</span>
                 <br/>
                 <span>Höhe ca. 190 mm, Schacht-Außenmaß 400 x 400 mm, </span>
                 <br/>
                 <span>aus gekantetem Stahlblech St 37, S235JR+AR nach EN 10025, feuerverzinkt nach DIN EN ISO 1461, Wandstärke 2 mm, Einlaufrand verstärkt 4 mm, mit dreiseitigem druckverteilendem Auflageflansch ca. 560x480 mm, einseitig offen, dreiseitige Anschlussmöglichkeit für 3 bis 4 Wasserleitprofile / Flachkanäle und rückseitige Ausklinkung für Dämmkeile ca. 105x105mm, Kieskasten mit senkrechter Schlitzlochung.</span>
                 <br/>
                 <span>Einliegender arretierbarer Deckel als feuerverzinkter Gitterrost, MW 30/10, Druckfestigkeit ca. 150 kg.</span>
                 <br/>
                 <span>Einbauen in Schotterflächen über vorhandener Siebabdeckung der Attikaentwässerung.</span>
                </p>
               </Text>
              </DetailTxt>
              <OutlineText>
               <OutlTxt>
                <TextOutlTxt>
                 <p style="text-align:left;margin-top:0pt;margin-bottom:0pt;">
                  <span>Attikakontrollschacht Stahl verzinkt 400x400 mm, Höhe ca. 190 mm, MW 30/10</span>
                 </p>
                </TextOutlTxt>
               </OutlTxt>
              </OutlineText>
             </CompleteText>
            </Description>
