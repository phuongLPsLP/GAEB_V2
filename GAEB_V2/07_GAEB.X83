        <BoQCtgy ID="ID_391" RNoPart="2">
         <LblTx>
          <span>WA 1.2   -   (SAP 10, KG 335-4) - Vorarbeiten</span>
          <br/>
          <span/>
         </LblTx>
         <BoQBody>
          <Itemlist>
           <Item ID="ID_392" RNoPart="1">
            <Qty>1893.000</Qty>
            <QU>m2</QU>
            <Description ID="1f270a80-c307-46b2-90fb-40682ec40345">
             <CompleteText>
              <DetailTxt>
               <Text>
                <p style="text-align:left;margin-top:0pt;margin-bottom:0pt;">
                 <span>Reinigen des Untergrundes aus Stahlbeton von grober Verschmutzung, von</span>
                 <br/>
                 <span>festhaftenden Verunreinigungen, Dicke bis 2 cm, durch Entfernen von Grobschmutz, zur Verbesserung der Haftung, anfallende Stoffe im Behälter des AN</span>
                 <br/>
                 <span>sammeln, Untergrund eben bzw. geneigt, Neigung bis 15 Grad; alle Decken; abgerechnet wird die Gesamtfläche, Grundrissform gemäß Pläne.</span>
                 <br/>
                 <br/>
                 <span>Ausführung nur auf Anordnung OÜ.</span>
                </p>
               </Text>
              </DetailTxt>
              <OutlineText>
               <OutlTxt>
                <TextOutlTxt>
                 <p style="text-align:left;margin-top:0pt;margin-bottom:0pt;">
                  <span>Reinigen des Untergrundes, horizontal</span>
                 </p>
                </TextOutlTxt>
               </OutlTxt>
              </OutlineText>
             </CompleteText>
            </Description>
           </Item>
           <Item ID="ID_393" RNoPart="2">
            <Qty>281.000</Qty>
            <QU>m2</QU>
            <Description ID="3fa89da2-f36c-4c9c-9a38-5823f14c8cec">
             <CompleteText>
              <DetailTxt>
               <Text>
                <p style="text-align:left;margin-top:0pt;margin-bottom:0pt;">
                 <span>Reinigen des Untergrundes aus Stahlbeton von grober Verschmutzung, von</span>
                 <br/>
                 <span>festhaftenden Verunreinigungen, Dicke bis 2 cm, durch Entfernen von Grobschmutz, zur Verbesserung der Haftung, anfallende Stoffe im Behälter des AN</span>
                 <br/>
                 <span>sammeln, Untergrund eben bzw. geneigt, Neigung bis 15 Grad; alle Decken; abgerechnet wird die Gesamtfläche, Grundrissform gemäß Pläne.</span>
                 <br/>
                 <br/>
