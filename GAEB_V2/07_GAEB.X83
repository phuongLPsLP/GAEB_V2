               <Text>
                <p style="text-align:left;margin-top:0pt;margin-bottom:0pt;">
                 <span>des vor beschriebenen Geländersystems </span>
                 <br/>
                 <br/>
                 <span>Ausführungsort: Attika Haus A und C</span>
                </p>
               </Text>
              </DetailTxt>
              <OutlineText>
