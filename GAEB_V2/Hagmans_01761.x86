           <Item ID="ID164" RNoPart="20">
            <UPBkdn>Yes</UPBkdn>
            <Qty>42.000</Qty>
            <QU>m</QU>
            <UP>37.260</UP>
            <UPComp1>23.920</UPComp1>
            <UPComp2>13.340</UPComp2>
            <IT>1564.92</IT>
            <TimeQu>23.00</TimeQu>
            <Description>
             <CompleteText>
              <DetailTxt>
               <Text>
                <p style="font-family:Times New Roman;font-size:14.0pt;">
                 <span style="font-family:Arial;Color:#000000;">Hängedachrinne, halbrund,</span>
                </p>
                <p style="font-family:Times New Roman;font-size:14.0pt;">
                 <span style="font-family:Arial;Color:#000000;">aus Edelstahl rostfrei - verzinnt, Werkstoffnummer</span>
                </p>
                <p style="font-family:Times New Roman;font-size:14.0pt;">
                 <span style="font-family:Arial;Color:#000000;">1.4509 FTE,</span>
                </p>
                <p style="font-family:Times New Roman;font-size:14.0pt;">
                 <span style="font-family:Arial;Color:#000000;">Metalldicke 0,4 mm,</span>
                </p>
                <p style="font-family:Times New Roman;font-size:14.0pt;">
                 <span style="font-family:Arial;Color:#000000;">Größe 5-teilig, Zuschnitt 400 mm, Durchmesser 192 mm,</span>
                </p>
                <p style="font-family:Times New Roman;font-size:14.0pt;">
                 <span style="font-family:Arial;Color:#000000;">einschließlich der erforderlichen verzinkten</span>
                </p>
                <p style="font-family:Times New Roman;font-size:14.0pt;">
                 <span style="font-family:Arial;Color:#000000;">Rinnenhalter,</span>
                </p>
                <p style="font-family:Times New Roman;font-size:14.0pt;">
                 <span style="font-family:Arial;Color:#000000;">Stärke 40 x 5 mm,</span>
                </p>
                <p style="font-family:Times New Roman;font-size:14.0pt;">
                 <span style="font-family:Arial;Color:#000000;">liefern und mit einem Gefälle von 1 - 3 mm einbauen.</span>
                </p>
                <p style="font-family:Times New Roman;font-size:14.0pt;"/>
                <p style="font-family:Times New Roman;font-size:14.0pt;">
                 <span style="font-family:Arial;Color:#000000;">Die Rinnenhalter oberflächenbündig in die</span>
                </p>
                <p style="font-family:Times New Roman;font-size:14.0pt;">
                 <span style="font-family:Arial;Color:#000000;">Unterkonstruktion einlassen,</span>
                </p>
                <p style="font-family:Times New Roman;font-size:14.0pt;">
                 <span style="font-family:Arial;Color:#000000;">Abstand nach DIN 18461, ca. 1,5 Stk pro lfdm.,</span>
                </p>
                <p style="font-family:Times New Roman;font-size:14.0pt;">
                 <span style="font-family:Arial;Color:#000000;">und mit Edelstahlnägeln 4,2 x 65 mm, 3 Stk. pro Halter,</span>
                </p>
                <p style="font-family:Times New Roman;font-size:14.0pt;">
                 <span style="font-family:Arial;Color:#000000;">in den Sparren mechanisch befestigen.</span>
                </p>
                <p style="font-family:Times New Roman;font-size:14.0pt;"/>
                <p style="font-family:Times New Roman;font-size:14.0pt;">
                 <span style="font-family:Arial;Color:#000000;">Die Rinne mit 10 bis max 15 mm Seitenüberdeckung</span>
                </p>
                <p style="font-family:Times New Roman;font-size:14.0pt;">
                 <span style="font-family:Arial;Color:#000000;">einbauen und die Überdeckungen mit Lötzinn und</span>
                </p>
                <p style="font-family:Times New Roman;font-size:14.0pt;">
                 <span style="font-family:Arial;Color:#000000;">Lötwasser nach Herstellervorgaben vollständig und</span>
                </p>
                <p style="font-family:Times New Roman;font-size:14.0pt;">
                 <span style="font-family:Arial;Color:#000000;">vollflächig auslöten.</span>
                </p>
                <p style="font-family:Times New Roman;font-size:14.0pt;">
                 <span style="font-family:Arial;Color:#000000;">Die Lötverbindungen unmittelbar nach dem Lötvorgang mit</span>
                </p>
                <p style="font-family:Times New Roman;font-size:14.0pt;">
                 <span style="font-family:Arial;Color:#000000;">Wasser und sauberem Lappen, falls erforderlich mit</span>
                </p>
                <p style="font-family:Times New Roman;font-size:14.0pt;">
                 <span style="font-family:Arial;Color:#000000;">Nachbehandlung durch   Reiniger gemäß</span>
                </p>
                <p style="font-family:Times New Roman;font-size:14.0pt;">
                 <span style="font-family:Arial;Color:#000000;">Herstellervorgaben, hauptsächlich an der Untersicht,</span>
                </p>
                <p style="font-family:Times New Roman;font-size:14.0pt;">
                 <span style="font-family:Arial;Color:#000000;">reinigen. Fließmittelrückstände führen zu Verfärbungen.</span>
                </p>
                <p style="font-family:Times New Roman;font-size:14.0pt;"/>
                <p style="font-family:Times New Roman;font-size:14.0pt;">
                 <span style="font-family:Arial;Color:#000000;">Die Rinnenlängen sind wegen der auftretenden</span>
                </p>
                <p style="font-family:Times New Roman;font-size:14.0pt;">
                 <span style="font-family:Arial;Color:#000000;">Längenausdehnung auf höchstens 14,00 m zu begrenzen.</span>
                </p>
                <p style="font-family:Times New Roman;font-size:14.0pt;">
                 <span style="font-family:Arial;Color:#000000;">Bei größeren Rinnenlängen sind Dehnungsausgleiche zu</span>
                </p>
                <p style="font-family:Times New Roman;font-size:14.0pt;">
                 <span style="font-family:Arial;Color:#000000;">schaffen.</span>
                </p>
                <p style="font-family:Times New Roman;font-size:14.0pt;"/>
                <p style="font-family:Times New Roman;font-size:14.0pt;">
                 <span style="font-family:Arial;Color:#000000;">Die Lieferung aller Materialien sowie alle</span>
                </p>
                <p style="font-family:Times New Roman;font-size:14.0pt;">
                 <span style="font-family:Arial;Color:#000000;">Nebenarbeiten sind in den Einheitspreis</span>
                </p>
                <p style="font-family:Times New Roman;font-size:14.0pt;">
                 <span style="font-family:Arial;Color:#000000;">einzukalkulieren.</span>
                </p>
                <p style="font-family:Times New Roman;font-size:14.0pt;"/>
               </Text>
              </DetailTxt>
              <OutlineText>
               <OutlTxt>
                <TextOutlTxt>
                 <span>Hängedachrinne, halbrd., Edelstahl, verzinnt, FTE, Zuschnitt 400 mm</span>
                </TextOutlTxt>
               </OutlTxt>
              </OutlineText>
             </CompleteText>
            </Description>
            <MWM:OZ>2.4.2.20</MWM:OZ>
           </Item>
