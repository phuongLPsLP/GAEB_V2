         <BoQBody>
          <Itemlist>
           <Item ID="ID145" RNoPart="1">
            <UPBkdn>Yes</UPBkdn>
            <Qty>610.000</Qty>
            <QU>m²</QU>
            <UP>17.400</UP>
            <UPComp1>8.320</UPComp1>
            <UPComp2>9.080</UPComp2>
            <IT>10614.00</IT>
            <TimeQu>8.00</TimeQu>
            <Description>
             <CompleteText>
              <DetailTxt>
               <Text>
                <p style="font-family:Times New Roman;font-size:14.0pt;">
                 <span style="font-family:Arial;Color:#000000;">Elastomerbitumen-Unterlagsbahn gem. DIN SPEC 20000-201,</span>
                </p>
                <p style="font-family:Times New Roman;font-size:14.0pt;">
                 <span style="font-family:Arial;Color:#000000;">Anwendungstyp:   DU,</span>
                </p>
                <p style="font-family:Times New Roman;font-size:14.0pt;">
                 <span style="font-family:Arial;Color:#000000;">Eigenschaftsklasse:   E1,</span>
                </p>
                <p style="font-family:Times New Roman;font-size:14.0pt;">
                 <span style="font-family:Arial;Color:#000000;">Bahnentyp:   PYE-KTG - 4,0,</span>
                </p>
                <p style="font-family:Times New Roman;font-size:14.0pt;">
                 <span style="font-family:Arial;Color:#000000;">im Nahtbereich selbstklebend mit schweißbarer</span>
                </p>
                <p style="font-family:Times New Roman;font-size:14.0pt;">
                 <span style="font-family:Arial;Color:#000000;">Sicherheits-Schweißnaht, für nagelbare Untergründe</span>
                </p>
                <p style="font-family:Times New Roman;font-size:14.0pt;">
                 <span style="font-family:Arial;Color:#000000;">(z.B. Holzschalung), oberseitig mit einer</span>
                </p>
                <p style="font-family:Times New Roman;font-size:14.0pt;">
                 <span style="font-family:Arial;Color:#000000;">überschweißbaren Spezialfolie kaschiert, unterseitig</span>
                </p>
                <p style="font-family:Times New Roman;font-size:14.0pt;">
                 <span style="font-family:Arial;Color:#000000;">mit einer Lochfolien-Sand-Kombination als dauerhafte</span>
                </p>
                <p style="font-family:Times New Roman;font-size:14.0pt;">
                 <span style="font-family:Arial;Color:#000000;">Trennlage versehen,</span>
                </p>
                <p style="font-family:Times New Roman;font-size:14.0pt;">
                 <span style="font-family:Arial;Color:#000000;">mit amtlichem Prüfzeugnis gemäß DIN 52123 und 52132 für</span>
                </p>
                <p style="font-family:Times New Roman;font-size:14.0pt;">
                 <span style="font-family:Arial;Color:#000000;">Höchstzugkraft, Dehnung, Kaltbiegeverhalten,</span>
                </p>
                <p style="font-family:Times New Roman;font-size:14.0pt;">
                 <span style="font-family:Arial;Color:#000000;">Wärmestandfestigkeit und Dicke, geprüft durch die MFPA</span>
                </p>
                <p style="font-family:Times New Roman;font-size:14.0pt;">
                 <span style="font-family:Arial;Color:#000000;">Leipzig, Nr.PZ / 98-931a,</span>
                </p>
                <p style="font-family:Times New Roman;font-size:14.0pt;">
                 <span style="font-family:Arial;Color:#000000;">Länge:              8,0 m,</span>
                </p>
                <p style="font-family:Times New Roman;font-size:14.0pt;">
                 <span style="font-family:Arial;Color:#000000;">Breite:   1,0 m,</span>
                </p>
                <p style="font-family:Times New Roman;font-size:14.0pt;">
                 <span style="font-family:Arial;Color:#000000;">Dicke:   4,0 mm,</span>
                </p>
                <p style="font-family:Times New Roman;font-size:14.0pt;">
                 <span style="font-family:Arial;Color:#000000;">Einlage:   KTG,</span>
                </p>
                <p style="font-family:Times New Roman;font-size:14.0pt;">
                 <span style="font-family:Arial;Color:#000000;">Brandverhalten:   Klasse E,</span>
                </p>
                <p style="font-family:Times New Roman;font-size:14.0pt;">
                 <span style="font-family:Arial;Color:#000000;">max. Zugkraft:   längs: 1300 N/50 mm,</span>
                </p>
                <p style="font-family:Times New Roman;font-size:14.0pt;">
                 <span style="font-family:Arial;Color:#000000;">   quer: 1500 N/50 mm,</span>
                </p>
                <p style="font-family:Times New Roman;font-size:14.0pt;">
                 <span style="font-family:Arial;Color:#000000;">Dehnung:   längs: 8 %,</span>
                </p>
                <p style="font-family:Times New Roman;font-size:14.0pt;">
                 <span style="font-family:Arial;Color:#000000;">   quer: 10 %,</span>
                </p>
                <p style="font-family:Times New Roman;font-size:14.0pt;">
                 <span style="font-family:Arial;Color:#000000;">Kaltbiegeverhalten:   - 30° C,</span>
                </p>
                <p style="font-family:Times New Roman;font-size:14.0pt;">
                 <span style="font-family:Arial;Color:#000000;">Wärmestandfestigkeit:   + 100° C,</span>
                </p>
                <p style="font-family:Times New Roman;font-size:14.0pt;">
                 <span style="font-family:Arial;Color:#000000;">liefern und gemäß Verlegeanweisung des Herstellers mit</span>
                </p>
                <p style="font-family:Times New Roman;font-size:14.0pt;">
                 <span style="font-family:Arial;Color:#000000;">mind. 8 cm Naht- und 12 cm Stoßüberdeckung in</span>
                </p>
                <p style="font-family:Times New Roman;font-size:14.0pt;">
                 <span style="font-family:Arial;Color:#000000;">Gefällerichtung mit Quernahtversatz lose auf der</span>
                </p>
                <p style="font-family:Times New Roman;font-size:14.0pt;">
                 <span style="font-family:Arial;Color:#000000;">Holzschalung verlegen und gemäß</span>
                </p>
                <p style="font-family:Times New Roman;font-size:14.0pt;">
                 <span style="font-family:Arial;Color:#000000;">DIN EN 1991-1-4/ Na:2010-12 mit zugelassenen</span>
                </p>
                <p style="font-family:Times New Roman;font-size:14.0pt;">
                 <span style="font-family:Arial;Color:#000000;">Befestigungselementen,</span>
                </p>
                <p style="font-family:Times New Roman;font-size:14.0pt;">
                 <span style="font-family:Arial;Color:#000000;">Fabrikat/Typ:   sfs intec, SP-40-FD/TS, ableitbare</span>
                </p>
                <p style="font-family:Times New Roman;font-size:14.0pt;">
                 <span style="font-family:Arial;Color:#000000;">Windsoglast 0,5 kN je Befestiger,</span>
                </p>
                <p style="font-family:Times New Roman;font-size:14.0pt;">
                 <span style="font-family:Arial;Color:#000000;">Befestigeranzahl:   i.M. 7 Stk./m² (kalkulatorisch),</span>
                </p>
                <p style="font-family:Times New Roman;font-size:14.0pt;">
                 <span style="font-family:Arial;Color:#000000;">mechanisch befestigen.</span>
                </p>
                <p style="font-family:Times New Roman;font-size:14.0pt;">
                 <span style="font-family:Arial;Color:#000000;">Die Naht- und Stoßüberdeckungen mit einem geeigneten</span>
                </p>
                <p style="font-family:Times New Roman;font-size:14.0pt;">
                 <span style="font-family:Arial;Color:#000000;">Schweißbrenner in mind. 8 cm Breite voll verschweißen,</span>
                </p>
                <p style="font-family:Times New Roman;font-size:14.0pt;">
                 <span style="font-family:Arial;Color:#000000;">die Wirkung der Sicherheitsnaht ist vor der</span>
                </p>
                <p style="font-family:Times New Roman;font-size:14.0pt;">
                 <span style="font-family:Arial;Color:#000000;">Verschweißung der Nähte und</span>
                </p>
                <p style="font-family:Times New Roman;font-size:14.0pt;">
                 <span style="font-family:Arial;Color:#000000;">Stöße auf volle Funktionsfähigkeit zu prüfen.</span>
                </p>
                <p style="font-family:Times New Roman;font-size:14.0pt;"/>
                <p style="font-family:Times New Roman;font-size:14.0pt;">
                 <span style="font-family:Arial;Color:#000000;">Bei einer fachgerechten Verarbeitung ist die</span>
                </p>
                <p style="font-family:Times New Roman;font-size:14.0pt;">
                 <span style="font-family:Arial;Color:#000000;">Tauglichkeit der fertig verlegten Unterlagsbahn für die</span>
                </p>
                <p style="font-family:Times New Roman;font-size:14.0pt;">
                 <span style="font-family:Arial;Color:#000000;">Funktion einer behelfsmäßigen Abdichtung</span>
                </p>
                <p style="font-family:Times New Roman;font-size:14.0pt;">
                 <span style="font-family:Arial;Color:#000000;">(Notabdichtung) gemäß der Verarbeitungsanweisungen für</span>
                </p>
                <p style="font-family:Times New Roman;font-size:14.0pt;">
                 <span style="font-family:Arial;Color:#000000;">einen Zeitraum von mind. 6 Wochen gegeben.</span>
                </p>
                <p style="font-family:Times New Roman;font-size:14.0pt;"/>
                <p style="font-family:Times New Roman;font-size:14.0pt;">
                 <span style="font-family:Arial;Color:#000000;">Richtqualität:    Kubivent SN-H 4 mm</span>
                </p>
               </Text>
              </DetailTxt>
              <OutlineText>
               <OutlTxt>
                <TextOutlTxt>
                 <span>DU/E1 PYE-KTG - 4,0, lose verlegt u. mech. befestigt</span>
                </TextOutlTxt>
               </OutlTxt>
              </OutlineText>
             </CompleteText>
            </Description>
            <MWM:OZ>2.4.2. 1</MWM:OZ>
           </Item>
           <Item ID="ID146" RNoPart="2">
            <UPBkdn>Yes</UPBkdn>
            <Qty>531.000</Qty>
            <QU>m</QU>
            <UP>1.700</UP>
            <UPComp2>1.700</UPComp2>
            <IT>902.70</IT>
            <TimeQu>0.00</TimeQu>
            <Description>
             <CompleteText>
              <DetailTxt>
               <Text>
                <p style="font-family:Times New Roman;font-size:14.0pt;">
                 <span style="font-family:Arial;Color:#000000;">Die zur Windsogsicherung im Eck- und Außenrandbereich</span>
                </p>
                <p style="font-family:Times New Roman;font-size:14.0pt;">
                 <span style="font-family:Arial;Color:#000000;">außerhalb der überdeckenden Nahtbereiche in der Bahn</span>
                </p>
                <p style="font-family:Times New Roman;font-size:14.0pt;">
                 <span style="font-family:Arial;Color:#000000;">gesetzten Befestiger mit zu liefernden 20 cm breiten</span>
                </p>
                <p style="font-family:Times New Roman;font-size:14.0pt;">
                 <span style="font-family:Arial;Color:#000000;">Streifen aus einer kaltselbstklebenden</span>
                </p>
                <p style="font-family:Times New Roman;font-size:14.0pt;">
                 <span style="font-family:Arial;Color:#000000;">Elastomerbitumen-Unterlagsbahn mit</span>
                </p>
                <p style="font-family:Times New Roman;font-size:14.0pt;">
                 <span style="font-family:Arial;Color:#000000;">Sicherheits-Schweißnaht, PYE-KTG KSP - 4,0, vollflächig</span>
                </p>
                <p style="font-family:Times New Roman;font-size:14.0pt;">
                 <span style="font-family:Arial;Color:#000000;">im Flämmverfahren überschweißen.</span>
                </p>
                <p style="font-family:Times New Roman;font-size:14.0pt;"/>
                <p style="font-family:Times New Roman;font-size:14.0pt;"/>
               </Text>
              </DetailTxt>
              <OutlineText>
               <OutlTxt>
                <TextOutlTxt>
                 <span>zusätzl. Befestigung überkleben, PYE-KTG KSP - 4,0, Str.br. 20 cm</span>
                </TextOutlTxt>
               </OutlTxt>
              </OutlineText>
             </CompleteText>
            </Description>
            <MWM:OZ>2.4.2. 2</MWM:OZ>
           </Item>
           <Item ID="ID147" RNoPart="3">
            <UPBkdn>Yes</UPBkdn>
            <Qty>610.000</Qty>
            <QU>m²</QU>
            <UP>20.630</UP>
            <UPComp1>7.800</UPComp1>
            <UPComp2>11.810</UPComp2>
            <UPComp5>1.020</UPComp5>
            <IT>12584.30</IT>
            <TimeQu>7.50</TimeQu>
            <Description>
             <CompleteText>
              <DetailTxt>
               <Text>
                <p style="font-family:Times New Roman;font-size:14.0pt;">
                 <span style="font-family:Arial;Color:#000000;">Elasto-plastische Premium-Spezialbitumen-Schweißbahn</span>
                </p>
                <p style="font-family:Times New Roman;font-size:14.0pt;">
                 <span style="font-family:Arial;Color:#000000;">als Oberlage gem. DIN SPEC 20000-201 / -202,</span>
                </p>
                <p style="font-family:Times New Roman;font-size:14.0pt;">
                 <span style="font-family:Arial;Color:#000000;">Anwendungstyp:   DO / BA, Typ T,</span>
                </p>
                <p style="font-family:Times New Roman;font-size:14.0pt;">
                 <span style="font-family:Arial;Color:#000000;">Eigenschaftsklasse:   E1,</span>
                </p>
                <p style="font-family:Times New Roman;font-size:14.0pt;">
                 <span style="font-family:Arial;Color:#000000;">Bahnentyp:   PYE/PYP KTP S5,</span>
                </p>
                <p style="font-family:Times New Roman;font-size:14.0pt;">
                 <span style="font-family:Arial;Color:#000000;">bestehend aus homogenem Spezialbitumen sowie einer</span>
                </p>
                <p style="font-family:Times New Roman;font-size:14.0pt;">
                 <span style="font-family:Arial;Color:#000000;">hochreißfesten und dehnfähigen</span>
                </p>
                <p style="font-family:Times New Roman;font-size:14.0pt;">
                 <span style="font-family:Arial;Color:#000000;">Kombinationsträger-Einlage</span>
                </p>
                <p style="font-family:Times New Roman;font-size:14.0pt;">
                 <span style="font-family:Arial;Color:#000000;">(KTP) für hohe Ansprüche, oberseitig mit einer</span>
                </p>
                <p style="font-family:Times New Roman;font-size:14.0pt;">
                 <span style="font-family:Arial;Color:#000000;">hochwertigen, deckungssicheren, fein strukturierten und</span>
                </p>
                <p style="font-family:Times New Roman;font-size:14.0pt;">
                 <span style="font-family:Arial;Color:#000000;">UV-beständigen</span>
                </p>
                <p style="font-family:Times New Roman;font-size:14.0pt;">
                 <span style="font-family:Arial;Color:#000000;">Schiefersplittbeschichtung versehen, unterseitig mit</span>
                </p>
                <p style="font-family:Times New Roman;font-size:14.0pt;">
                 <span style="font-family:Arial;Color:#000000;">einer Spezialfolie kaschiert,</span>
                </p>
                <p style="font-family:Times New Roman;font-size:14.0pt;">
                 <span style="font-family:Arial;Color:#000000;">Farbe:   basaltschwarz,</span>
                </p>
                <p style="font-family:Times New Roman;font-size:14.0pt;">
                 <span style="font-family:Arial;Color:#000000;">Bahnenbreite:   1,0 m,</span>
                </p>
                <p style="font-family:Times New Roman;font-size:14.0pt;">
                 <span style="font-family:Arial;Color:#000000;">Bahnendicke:   5,2 mm,</span>
                </p>
                <p style="font-family:Times New Roman;font-size:14.0pt;">
                 <span style="font-family:Arial;Color:#000000;">Einlage:   KTP 270 g/m²,</span>
                </p>
                <p style="font-family:Times New Roman;font-size:14.0pt;">
                 <span style="font-family:Arial;Color:#000000;">Wasserdichtheit:   bestanden bei 400 kPa/24h,</span>
                </p>
                <p style="font-family:Times New Roman;font-size:14.0pt;">
                 <span style="font-family:Arial;Color:#000000;">Brand von außen:   Broof(t1) im Systemaufbau nach</span>
                </p>
                <p style="font-family:Times New Roman;font-size:14.0pt;">
                 <span style="font-family:Arial;Color:#000000;">   Herstellerangaben,</span>
                </p>
                <p style="font-family:Times New Roman;font-size:14.0pt;">
                 <span style="font-family:Arial;Color:#000000;">Brandverhalten:   Klasse E (DIN 13501-1),</span>
                </p>
                <p style="font-family:Times New Roman;font-size:14.0pt;">
                 <span style="font-family:Arial;Color:#000000;">max. Zugkraft:   1450 N/50 mm,</span>
                </p>
                <p style="font-family:Times New Roman;font-size:14.0pt;">
                 <span style="font-family:Arial;Color:#000000;">Dehnung:   &#x3e; 35 %,</span>
                </p>
                <p style="font-family:Times New Roman;font-size:14.0pt;">
                 <span style="font-family:Arial;Color:#000000;">Kaltbiegeverhalten:   - 22° C,</span>
                </p>
                <p style="font-family:Times New Roman;font-size:14.0pt;">
                 <span style="font-family:Arial;Color:#000000;">Wärmestandfestigkeit:   + 150° C,</span>
                </p>
                <p style="font-family:Times New Roman;font-size:14.0pt;">
                 <span style="font-family:Arial;Color:#000000;">Plastizitätsspanne:   172 K,</span>
                </p>
                <p style="font-family:Times New Roman;font-size:14.0pt;">
                 <span style="font-family:Arial;Color:#000000;">Bahnenlängen:   6,0 und 4,3 m,</span>
                </p>
                <p style="font-family:Times New Roman;font-size:14.0pt;">
                 <span style="font-family:Arial;Color:#000000;">liefern und mit mind. 8 cm Naht-  und 12 cm</span>
                </p>
                <p style="font-family:Times New Roman;font-size:14.0pt;">
                 <span style="font-family:Arial;Color:#000000;">Stoßüberdeckung</span>
                </p>
                <p style="font-family:Times New Roman;font-size:14.0pt;">
                 <span style="font-family:Arial;Color:#000000;">in Gefällerichtung im Lagen- und durch nebeneinander</span>
                </p>
                <p style="font-family:Times New Roman;font-size:14.0pt;">
                 <span style="font-family:Arial;Color:#000000;">versetzte</span>
                </p>
                <p style="font-family:Times New Roman;font-size:14.0pt;">
                 <span style="font-family:Arial;Color:#000000;">Verlegung der beiden Längen im Quernahtversatz auf die</span>
                </p>
                <p style="font-family:Times New Roman;font-size:14.0pt;">
                 <span style="font-family:Arial;Color:#000000;">in vorstehender Position beschriebene erste</span>
                </p>
                <p style="font-family:Times New Roman;font-size:14.0pt;">
                 <span style="font-family:Arial;Color:#000000;">Abdichtungslage vollflächig aufschweißen.</span>
                </p>
                <p style="font-family:Times New Roman;font-size:14.0pt;"/>
                <p style="font-family:Times New Roman;font-size:14.0pt;">
                 <span style="font-family:Arial;Color:#000000;">Als Alternative sind Hybrid-Bahnen (zwei durch die</span>
                </p>
                <p style="font-family:Times New Roman;font-size:14.0pt;">
                 <span style="font-family:Arial;Color:#000000;">Trägereinlage getrennte Bitumenarten) nicht zulässig!</span>
                </p>
                <p style="font-family:Times New Roman;font-size:14.0pt;"/>
                <p style="font-family:Times New Roman;font-size:14.0pt;">
                 <span style="font-family:Arial;Color:#000000;">Richtqualität:    Kubidritt XLP</span>
                </p>
                <p style="font-family:Times New Roman;font-size:14.0pt;"/>
               </Text>
              </DetailTxt>
              <OutlineText>
               <OutlTxt>
                <TextOutlTxt>
                 <span>DO/E1 PYE/PYP KTP S5, vollflächig</span>
                </TextOutlTxt>
               </OutlTxt>
              </OutlineText>
             </CompleteText>
            </Description>
            <MWM:OZ>2.4.2. 3</MWM:OZ>
           </Item>
           <Item ID="ID148" RNoPart="4">
            <UPBkdn>Yes</UPBkdn>
            <Qty>15.000</Qty>
            <QU>St</QU>
            <UP>160.370</UP>
            <UPComp1>46.800</UPComp1>
            <UPComp2>113.570</UPComp2>
            <IT>2405.55</IT>
            <TimeQu>45.00</TimeQu>
            <Description>
             <CompleteText>
              <DetailTxt>
               <Text>
                <p style="font-family:Times New Roman;font-size:14.0pt;">
                 <span style="font-family:Arial;Color:#000000;">Edelstahl-Dunstrohr mit Flansch (500 x 500 mm) aus</span>
                </p>
                <p style="font-family:Times New Roman;font-size:14.0pt;">
                 <span style="font-family:Arial;Color:#000000;">aufgeschäumter Elastomerbitumen-Schweißbahn auf</span>
                </p>
                <p style="font-family:Times New Roman;font-size:14.0pt;">
                 <span style="font-family:Arial;Color:#000000;">Edelstahl-Trägerplatte, inklusive abnehmbarer</span>
                </p>
                <p style="font-family:Times New Roman;font-size:14.0pt;">
                 <span style="font-family:Arial;Color:#000000;">schlagregensicherer Schutzhaube aus Edelstahl,</span>
                </p>
                <p style="font-family:Times New Roman;font-size:14.0pt;">
                 <span style="font-family:Arial;Color:#000000;">Durchmesser 110 mm,</span>
                </p>
                <p style="font-family:Times New Roman;font-size:14.0pt;"/>
                <p style="font-family:Times New Roman;font-size:14.0pt;">
                 <span style="font-family:Arial;Color:#000000;">angeb. Fabrikat:</span>
                </p>
                <p style="font-family:Times New Roman;font-size:14.0pt;">
                 <span style="font-family:Arial;Color:#000000;">.......................................................</span>
                </p>
                <p style="font-family:Times New Roman;font-size:14.0pt;">
                 <span style="font-family:Arial;Color:#000000;">,</span>
                </p>
                <p style="font-family:Times New Roman;font-size:14.0pt;">
                 <span style="font-family:Arial;Color:#000000;">liefern, gemäß Herstellervorschrift einbauen und an die</span>
                </p>
                <p style="font-family:Times New Roman;font-size:14.0pt;">
                 <span style="font-family:Arial;Color:#000000;">Abdichtungsschicht anschließen.</span>
                </p>
                <p style="font-family:Times New Roman;font-size:14.0pt;"/>
               </Text>
              </DetailTxt>
              <OutlineText>
               <OutlTxt>
                <TextOutlTxt>
                 <span>Dunstrohr, Edelstahl, Durchm. 110 mm</span>
                </TextOutlTxt>
               </OutlTxt>
              </OutlineText>
             </CompleteText>
            </Description>
            <MWM:OZ>2.4.2. 4</MWM:OZ>
           </Item>
           <Item ID="ID149" RNoPart="5">
            <UPBkdn>Yes</UPBkdn>
            <Qty>7.000</Qty>
            <QU>St</QU>
            <UP>177.600</UP>
            <UPComp1>62.400</UPComp1>
            <UPComp2>115.200</UPComp2>
            <IT>1243.20</IT>
            <TimeQu>60.00</TimeQu>
            <Description>
             <CompleteText>
              <DetailTxt>
               <Text>
                <p style="font-family:Times New Roman;font-size:14.0pt;">
                 <span style="font-family:Arial;Color:#000000;">Zwangsentlüfter für die Entlüftung der Dachbodenräume,</span>
                </p>
                <p style="font-family:Times New Roman;font-size:14.0pt;">
                 <span style="font-family:Arial;Color:#000000;">Größe: DR 125,</span>
                </p>
                <p style="font-family:Times New Roman;font-size:14.0pt;">
                 <span style="font-family:Arial;Color:#000000;">liefern, passenden Durchbruch in der Holzschalung</span>
                </p>
                <p style="font-family:Times New Roman;font-size:14.0pt;">
                 <span style="font-family:Arial;Color:#000000;">herstellen, fachgerecht einbauen und mit</span>
                </p>
                <p style="font-family:Times New Roman;font-size:14.0pt;">
                 <span style="font-family:Arial;Color:#000000;">Flüssigkunststoff an die Dachhaut anschließen.</span>
                </p>
                <p style="font-family:Times New Roman;font-size:14.0pt;"/>
                <p style="font-family:Times New Roman;font-size:14.0pt;">
                 <span style="font-family:Arial;Color:#000000;">Richtqualität:    Schopax Ventalu -Entlüfter Typ DR</span>
                </p>
                <p style="font-family:Times New Roman;font-size:14.0pt;"/>
                <p style="font-family:Times New Roman;font-size:14.0pt;"/>
               </Text>
              </DetailTxt>
              <OutlineText>
               <OutlTxt>
                <TextOutlTxt>
                 <span>Zwangsentlüfter, DR 125</span>
