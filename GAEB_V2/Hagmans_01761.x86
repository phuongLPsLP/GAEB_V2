            <QU>m²</QU>
            <UP>1.560</UP>
            <UPComp1>1.560</UPComp1>
            <UPComp2>0.000</UPComp2>
            <IT>811.20</IT>
            <TimeQu>1.50</TimeQu>
            <Description>
             <CompleteText>
              <DetailTxt>
               <Text>
                <p style="font-family:Times New Roman;font-size:14.0pt;">
                 <span style="font-family:Arial;Color:#000000;">Holzschalung überprüfen, ggf. nachnageln, sorgfältig</span>
                </p>
                <p style="font-family:Times New Roman;font-size:14.0pt;">
                 <span style="font-family:Arial;Color:#000000;">reinigen, losen Schmutz abfegen, den anfallenden Schutt</span>
                </p>
                <p style="font-family:Times New Roman;font-size:14.0pt;">
                 <span style="font-family:Arial;Color:#000000;">heruntertransportieren, abfahren und entsorgen.</span>
                </p>
               </Text>
              </DetailTxt>
              <OutlineText>
               <OutlTxt>
                <TextOutlTxt>
                 <span>Holzschalung reinigen, Schmutz abfegen, ...entsorgen</span>
                </TextOutlTxt>
               </OutlTxt>
              </OutlineText>
             </CompleteText>
            </Description>
            <MWM:OZ>2.2.1.25</MWM:OZ>
           </Item>
           <Item ID="ID38" RNoPart="26">
            <UPBkdn>Yes</UPBkdn>
            <Qty>120.000</Qty>
            <QU>m²</QU>
            <UP>54.710</UP>
            <UPComp1>39.520</UPComp1>
            <UPComp2>15.190</UPComp2>
            <IT>6565.20</IT>
            <TimeQu>38.00</TimeQu>
            <Description>
             <CompleteText>
              <DetailTxt>
               <Text>
                <p style="font-family:Times New Roman;font-size:14.0pt;">
                 <span style="font-family:Arial;Color:#000000;">Vorhandene Holzschalung sorgfältig überprüfen,</span>
                </p>
                <p style="font-family:Times New Roman;font-size:14.0pt;">
                 <span style="font-family:Arial;Color:#000000;">schadhaftes Holz demontieren (ca. 5 % der</span>
                </p>
                <p style="font-family:Times New Roman;font-size:14.0pt;">
                 <span style="font-family:Arial;Color:#000000;">Gesamtfläche), den anfallenden Schutt</span>
                </p>
                <p style="font-family:Times New Roman;font-size:14.0pt;">
                 <span style="font-family:Arial;Color:#000000;">heruntertransportieren, abfahren und entsorgen.</span>
                </p>
                <p style="font-family:Times New Roman;font-size:14.0pt;">
                 <span style="font-family:Arial;Color:#000000;">Durch neue Rauhspund-Schalung aus Nadelholz,</span>
                </p>
                <p style="font-family:Times New Roman;font-size:14.0pt;">
                 <span style="font-family:Arial;Color:#000000;">trocken (Holzfeuchte um im Einbauzustand = 15  3 %),</span>
                </p>
                <p style="font-family:Times New Roman;font-size:14.0pt;">
                 <span style="font-family:Arial;Color:#000000;">mindestens Sortierklasse S 10, Mindestbreite 120 mm,</span>
                </p>
                <p style="font-family:Times New Roman;font-size:14.0pt;">
                 <span style="font-family:Arial;Color:#000000;">Mindestdicke 24 mm (Nenndicke), imprägniert, ersetzen.</span>
                </p>
                <p style="font-family:Times New Roman;font-size:14.0pt;">
                 <span style="font-family:Arial;Color:#000000;">Mit mindestens zwei feuerverzinkten Drahtstiften je</span>
                </p>
                <p style="font-family:Times New Roman;font-size:14.0pt;">
                 <span style="font-family:Arial;Color:#000000;">Brett und Auflager mechanisch befestigen.</span>
                </p>
                <p style="font-family:Times New Roman;font-size:14.0pt;"/>
                <p style="font-family:Times New Roman;font-size:14.0pt;">
                 <span style="font-family:Arial;Color:#000000;">Inklusive Lieferung aller notwendigen Materialien und</span>
                </p>
                <p style="font-family:Times New Roman;font-size:14.0pt;">
                 <span style="font-family:Arial;Color:#000000;">aller Nebenleistungen.</span>
                </p>
               </Text>
              </DetailTxt>
              <OutlineText>
               <OutlTxt>
                <TextOutlTxt>
                 <span>Vorh. schadhafte Holzschalung austauschen</span>
                </TextOutlTxt>
               </OutlTxt>
              </OutlineText>
             </CompleteText>
            </Description>
            <MWM:OZ>2.2.1.26</MWM:OZ>
