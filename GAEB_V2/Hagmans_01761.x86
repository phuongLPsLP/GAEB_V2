           <Item ID="ID49" RNoPart="11">
            <UPBkdn>Yes</UPBkdn>
            <Qty>1.000</Qty>
            <QU>St</QU>
            <UP>62.800</UP>
            <UPComp1>20.800</UPComp1>
            <UPComp2>42.000</UPComp2>
            <IT>62.80</IT>
            <TimeQu>20.00</TimeQu>
            <Description>
             <CompleteText>
              <DetailTxt>
               <Text>
                <p style="font-family:Times New Roman;font-size:14.0pt;">
                 <span style="font-family:Arial;Color:#000000;">Abschließbare Wandbefestigung, passend für die in der</span>
                </p>
                <p style="font-family:Times New Roman;font-size:14.0pt;">
                 <span style="font-family:Arial;Color:#000000;">Vorposition genannten Alu-Leitern, liefern und</span>
                </p>
                <p style="font-family:Times New Roman;font-size:14.0pt;">
                 <span style="font-family:Arial;Color:#000000;">fachgerecht nach Anweisung der Bauleitung im Innenraum</span>
                </p>
                <p style="font-family:Times New Roman;font-size:14.0pt;">
                 <span style="font-family:Arial;Color:#000000;">montieren.</span>
                </p>
               </Text>
              </DetailTxt>
              <OutlineText>
               <OutlTxt>
                <TextOutlTxt>
                 <span>Wandbefestigung für Leiter, abschließbar</span>
                </TextOutlTxt>
               </OutlTxt>
              </OutlineText>
             </CompleteText>
            </Description>
            <MWM:OZ>2.2.2.11</MWM:OZ>
