              <DetailTxt>
               <Text>
                <p style="font-family:Times New Roman;font-size:14.0pt;">
                 <span style="font-family:Arial;Color:#000000;">Aluminium Z-Profil, 3-fach gekantet, aus 1,5 mm</span>
                </p>
                <p style="font-family:Times New Roman;font-size:14.0pt;">
                 <span style="font-family:Arial;Color:#000000;">Alu-Blech,</span>
                </p>
                <p style="font-family:Times New Roman;font-size:14.0pt;">
                 <span style="font-family:Arial;Color:#000000;">Abwicklung:   150 mm,</span>
                </p>
                <p style="font-family:Times New Roman;font-size:14.0pt;">
                 <span style="font-family:Arial;Color:#000000;">Oberflächen-Ausführung:   alu natur,</span>
                </p>
                <p style="font-family:Times New Roman;font-size:14.0pt;"/>
                <p style="font-family:Times New Roman;font-size:14.0pt;">
                 <span style="font-family:Arial;Color:#000000;">angeb. Fabrikat:</span>
                </p>
                <p style="font-family:Times New Roman;font-size:14.0pt;">
                 <span style="font-family:Arial;Color:#000000;">.......................................................</span>
                </p>
                <p style="font-family:Times New Roman;font-size:14.0pt;">
                 <span style="font-family:Arial;Color:#000000;">...,</span>
                </p>
                <p style="font-family:Times New Roman;font-size:14.0pt;">
                 <span style="font-family:Arial;Color:#000000;">liefern und mit zu liefernden Schrauben und Dübeln</span>
                </p>
                <p style="font-family:Times New Roman;font-size:14.0pt;">
                 <span style="font-family:Arial;Color:#000000;">einschließlich eines komprimierbaren Dichtungsbandes</span>
                </p>
                <p style="font-family:Times New Roman;font-size:14.0pt;">
                 <span style="font-family:Arial;Color:#000000;">als Überhangprofil oberhalb des Wandanschlusses</span>
                </p>
                <p style="font-family:Times New Roman;font-size:14.0pt;">
                 <span style="font-family:Arial;Color:#000000;">montieren und mit elastischem Material versiegeln.</span>
                </p>
                <p style="font-family:Times New Roman;font-size:14.0pt;"/>
