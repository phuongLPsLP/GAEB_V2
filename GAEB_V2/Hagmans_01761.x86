           <Item ID="ID58" RNoPart="20">
            <UPBkdn>Yes</UPBkdn>
            <Qty>50.500</Qty>
            <QU>m</QU>
            <UP>13.890</UP>
            <UPComp1>4.680</UPComp1>
            <UPComp2>9.210</UPComp2>
            <IT>701.45</IT>
            <TimeQu>4.50</TimeQu>
            <Description>
             <CompleteText>
              <DetailTxt>
               <Text>
                <p style="font-family:Times New Roman;font-size:14.0pt;">
                 <span style="font-family:Arial;Color:#000000;">Traufstreifen für Abdichtung aus Bitumenbahnen,</span>
                </p>
                <p style="font-family:Times New Roman;font-size:14.0pt;">
                 <span style="font-family:Arial;Color:#000000;">aus Edelstahl rostfrei - verzinnt, Werkstoffnummer</span>
                </p>
                <p style="font-family:Times New Roman;font-size:14.0pt;">
                 <span style="font-family:Arial;Color:#000000;">1.4509 FTE,</span>
                </p>
                <p style="font-family:Times New Roman;font-size:14.0pt;">
                 <span style="font-family:Arial;Color:#000000;">Metalldicke 0,4 mm, Zuschnitt 285 mm (7-teilig),</span>
                </p>
                <p style="font-family:Times New Roman;font-size:14.0pt;">
                 <span style="font-family:Arial;Color:#000000;">als Stützblech, mit vorderer Tropfkante,</span>
                </p>
                <p style="font-family:Times New Roman;font-size:14.0pt;">
                 <span style="font-family:Arial;Color:#000000;">in die Feder des Rinnenhalters eingehängt, die</span>
                </p>
                <p style="font-family:Times New Roman;font-size:14.0pt;">
                 <span style="font-family:Arial;Color:#000000;">einzelnen Traufstreifen 100 - 120 mm lose überlappend</span>
                </p>
                <p style="font-family:Times New Roman;font-size:14.0pt;">
                 <span style="font-family:Arial;Color:#000000;">und im Höhen- und Seitenversatz im Abstand von max. 50</span>
                </p>
                <p style="font-family:Times New Roman;font-size:14.0pt;">
                 <span style="font-family:Arial;Color:#000000;">mm in die Traufbohle / Unterkonstruktion direkt</span>
                </p>
                <p style="font-family:Times New Roman;font-size:14.0pt;">
                 <span style="font-family:Arial;Color:#000000;">windsogsicher mechanisch befestigt</span>
                </p>
                <p style="font-family:Times New Roman;font-size:14.0pt;">
                 <span style="font-family:Arial;Color:#000000;">einbauen.</span>
                </p>
                <p style="font-family:Times New Roman;font-size:14.0pt;"/>
                <p style="font-family:Times New Roman;font-size:14.0pt;">
                 <span style="font-family:Arial;Color:#000000;">Inklusive Anschleifen der Oberfläche im direkten</span>
                </p>
                <p style="font-family:Times New Roman;font-size:14.0pt;">
                 <span style="font-family:Arial;Color:#000000;">Anschlussbereich</span>
                </p>
                <p style="font-family:Times New Roman;font-size:14.0pt;">
                 <span style="font-family:Arial;Color:#000000;">und Herstellen eines Haftgrundes mit</span>
                </p>
                <p style="font-family:Times New Roman;font-size:14.0pt;">
                 <span style="font-family:Arial;Color:#000000;">Bitumenvoranstrich.</span>
                </p>
                <p style="font-family:Times New Roman;font-size:14.0pt;"/>
                <p style="font-family:Times New Roman;font-size:14.0pt;">
                 <span style="font-family:Arial;Color:#000000;">Die Lieferung aller Materialien sowie alle</span>
                </p>
                <p style="font-family:Times New Roman;font-size:14.0pt;">
                 <span style="font-family:Arial;Color:#000000;">Nebenarbeiten sind in den Einheitspreis</span>
                </p>
                <p style="font-family:Times New Roman;font-size:14.0pt;">
                 <span style="font-family:Arial;Color:#000000;">einzukalkulieren.</span>
                </p>
                <p style="font-family:Times New Roman;font-size:14.0pt;"/>
               </Text>
              </DetailTxt>
              <OutlineText>
               <OutlTxt>
                <TextOutlTxt>
                 <span>Traufstreifen, FTE-Edelstahl, Zuschnitt 285 mm</span>
                </TextOutlTxt>
               </OutlTxt>
              </OutlineText>
             </CompleteText>
            </Description>
            <MWM:OZ>2.2.2.20</MWM:OZ>
           </Item>
