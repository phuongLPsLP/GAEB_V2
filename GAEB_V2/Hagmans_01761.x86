             <CompleteText>
              <DetailTxt>
               <Text>
                <p style="font-family:Times New Roman;font-size:14.0pt;">
                 <span style="font-family:Arial;Color:#000000;">Edelstahl-Eindichtungsmanschette mit Flansch (500 x 500</span>
                </p>
                <p style="font-family:Times New Roman;font-size:14.0pt;">
                 <span style="font-family:Arial;Color:#000000;">mm) aus aufgeschäumter Elastomerbitumen-Schweißbahn auf</span>
                </p>
                <p style="font-family:Times New Roman;font-size:14.0pt;">
